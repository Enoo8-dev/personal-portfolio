---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/sections/Contact.astro';
import Connect from '../components/sections/Connect.astro';

const lang = 'en'; // Lingua fissa per questa pagina
---

<Layout 
    title="Connect with Federico Benini | Digital Business Card" 
    description="Get in touch with Federico Benini, save my contact details (vCard), or connect on LinkedIn and GitHub."
    lang={lang} 
    image='/images/og-image-en.png'
>
    <main class="flex flex-col items-center w-full">
        <Connect lang={lang} />
        <Contact lang={lang} />
    </main>
</Layout>