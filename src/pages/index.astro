---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import Hero from '../components/sections/Hero.astro';
import Skills from '../components/sections/Skills.astro';
import Contact from '../components/sections/Contact.astro';
import Projects from '../components/sections/Projects.astro';

const lang = 'en'; // Lingua fissa per questa pagina
const t = useTranslations(lang);
---

<Layout 
    title="Federico Benini | Full Stack Web Developer in Ferrara, Italy" 
    description="Hi, I'm Federico Benini, a Full Stack Developer based in Ferrara, Italy. I design and build fast websites, modern web applications, and user-first software solutions."
    lang={lang} 
    image='/images/og-image-en.png'
>
    <main class="flex flex-col items-center w-full">
        <Hero lang={lang} />
        <Skills lang={lang} />
        <Projects lang={lang} />
        <Contact lang={lang} />
    </main>
</Layout>