---
import Footer from "../components/common/Footer.astro";
import Navbar from "../components/common/Navbar.astro";
import { personalInfo } from "../data/business";
import "../styles/global.css";

import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';

import '@fontsource/noto-sans/400.css';
import '@fontsource/noto-sans/500.css';
import '@fontsource/noto-sans/700.css';

interface Props {
    title: string;
    description?: string;
    image?: string;
    lang?: 'en' | 'it';
    hasTranslation?: boolean;
    noindex?: boolean;
}

const { 
    title, 
    lang = 'en',
    description = lang === 'it'
        ? "Federico Benini - Full Stack Developer a Ferrara. Realizzazione siti web moderni, applicazioni web su misura e soluzioni software veloci e ottimizzate SEO."
        : "Federico Benini - Full Stack Developer in Ferrara, Italy. Creating elegant web applications, fast websites, and user-first software solutions.",
    image = lang === 'it' ? "/images/og-image-it.png" : "/images/og-image-en.png",
    hasTranslation = true,
    noindex = false,
} = Astro.props;

// Normalizza il path assicurando sempre lo slash finale (coerente con Apache)
const ensureTrailingSlash = (path: string) => path.endsWith('/') ? path : `${path}/`;

const currentPath = ensureTrailingSlash(Astro.url.pathname);
const canonicalURL = new URL(currentPath, Astro.site);

// Rimuove il prefisso '/it/' per calcolare il percorso base neutro
const strippedPath = currentPath.replace(/^\/it(\/|$)/, '/');
const normalizedPath = ensureTrailingSlash(strippedPath === '' ? '/' : strippedPath);

const enUrl = new URL(normalizedPath, Astro.site);
const itUrl = new URL(normalizedPath === '/' ? '/it/' : `/it${normalizedPath}`, Astro.site);
const ogImageUrl = new URL(image, Astro.site).href;

const locales = {
    en: 'en_US',
    it: 'it_IT'
};

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": "https://beninifederico.it/#website",
            "url": lang === 'it' ? "https://beninifederico.it/it/" : "https://beninifederico.it/",
            "name": "Federico Benini",
            "alternateName": "Federico Benini Portfolio",
            "inLanguage": lang === 'it' ? "it-IT" : "en-US",
            "publisher": {
                "@id": "https://beninifederico.it/#person"
            }
        },
        {
            "@type": "Person",
            "@id": "https://beninifederico.it/#person",
            "name": personalInfo.fullName,
            "givenName": personalInfo.firstName,
            "familyName": personalInfo.lastName,
            "jobTitle": personalInfo.role,
            "url": lang === 'it' ? "https://beninifederico.it/it/" : "https://beninifederico.it/",
            "image": ogImageUrl,
            "email": `mailto:${personalInfo.email}`,
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Ferrara",
                "addressRegion": "FE",
                "postalCode": "44121",
                "addressCountry": "IT"
            },
            "sameAs": [
                personalInfo.social.linkedin,
                personalInfo.social.github
            ],
            "knowsAbout": [
                "Web Development",
                "Full Stack Development",
                "Realizzazione Siti Web",
                "Astro",
                "Angular",
                "TypeScript",
                "Node.js",
                "Tailwind CSS",
                "Search Engine Optimization (SEO)"
            ]
        },
        {
            "@type": "ProfessionalService",
            "@id": "https://beninifederico.it/#business",
            "name": lang === 'it'
                ? "Federico Benini - Full Stack Developer & Realizzazione Siti Web Ferrara"
                : "Federico Benini - Full Stack Web Developer",
            "description": description,
            "url": canonicalURL.href,
            "image": ogImageUrl,
            "email": personalInfo.email,
            "vatID": `IT${personalInfo.p_iva}`,
            "priceRange": "$$",
            "founder": {
                "@id": "https://beninifederico.it/#person"
            },
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Ferrara",
                "addressRegion": "FE",
                "postalCode": "44121",
                "addressCountry": "IT"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 44.8381,
                "longitude": 11.6198
            },
            "areaServed": [
                {
                    "@type": "City",
                    "name": "Ferrara"
                },
                {
                    "@type": "AdministrativeArea",
                    "name": "Emilia-Romagna"
                },
                {
                    "@type": "Country",
                    "name": "Italy"
                }
            ],
            "sameAs": [
                personalInfo.social.linkedin,
                personalInfo.social.github
            ],
            "hasOfferCatalog": {
                "@type": "OfferCatalog",
                "name": lang === 'it' ? "Servizi di Sviluppo Web e Software" : "Web & Software Development Services",
                "itemListElement": [
                    {
                        "@type": "Offer",
                        "itemOffered": {
                            "@type": "Service",
                            "name": lang === 'it' ? "Realizzazione Siti Web Professionali a Ferrara" : "Custom Website Development"
                        }
                    },
                    {
                        "@type": "Offer",
                        "itemOffered": {
                            "@type": "Service",
                            "name": lang === 'it' ? "Sviluppo Web App e Software su Misura" : "Full Stack Web Application Development"
                        }
                    },
                    {
                        "@type": "Offer",
                        "itemOffered": {
                            "@type": "Service",
                            "name": lang === 'it' ? "Ottimizzazione SEO Tecnica e Performance Web" : "Technical SEO & Web Performance Optimization"
                        }
                    }
                ]
            }
        }
    ]
};

const GTM_ID = import.meta.env.PUBLIC_GTM_ID;
---

<!doctype html>
<html lang={lang} class="dark">
    <head>
        <meta charset="UTF-8" />
        <script define:vars={{ GTM_ID }}>
            document.addEventListener("DOMContentLoaded", () => {
                let gtmLoaded = false;
                
                const loadGTM = () => {
                if (gtmLoaded) return;
                gtmLoaded = true;
                
                (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                })(window,document,'script','dataLayer', GTM_ID);
                };

                // se l'utente si muove, carica GTM
                ['scroll', 'mousemove', 'touchstart', 'click'].forEach(event => {
                    window.addEventListener(event, loadGTM, { once: true });
                });

                // se l'utente non fa nulla per 3.5 secondi, carica GTM comunque
                setTimeout(loadGTM, 3500);
            });
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <!-- SEO Principale -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Federico Benini" />

        {noindex ? (
            <meta name="robots" content="noindex, nofollow" />
        ) : (
            <link rel="canonical" href={canonicalURL.href} />
        )}

        <!-- Hreflang Tags (generati solo se la pagina è indicizzabile e ha la traduzione) -->
        {!noindex && hasTranslation && (
            <>
                <link rel="alternate" hreflang="en" href={enUrl.href} />
                <link rel="alternate" hreflang="it" href={itUrl.href} />
                <link rel="alternate" hreflang="x-default" href={enUrl.href} />
            </>
        )}

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Federico Benini" />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
        <meta property="og:locale" content={locales[lang]} />
        {hasTranslation && (
            <meta property="og:locale:alternate" content={lang === 'en' ? locales.it : locales.en} />
        )}

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL.href} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />

        <!-- Dati Strutturati JSON-LD Schema.org -->
        {!noindex && (
            <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        )}

        <!-- Change Theme -->
        <script is:inline>
            const getThemePreference = () => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme-portfolio')) {
                    return localStorage.getItem('theme-portfolio');
                }
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            };
            const isDark = getThemePreference() === 'dark';
            document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
        
            if (typeof localStorage !== 'undefined') {
                const observer = new MutationObserver(() => {
                    const isDark = document.documentElement.classList.contains('dark');
                    localStorage.setItem('theme-portfolio', isDark ? 'dark' : 'light');
                });
                observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
            }
        </script>
    </head>
    <body>
        {GTM_ID && (
            <noscript>
                <iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
            </noscript>
        )}
        <Navbar lang={lang}/>
        <slot />
        <Footer lang={lang}/>
    </body>
</html>